@model EMP.Entities.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container mt-4">

    <h2>Delete Department</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this department?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Department Name
        </dt>

        <dd class="col-sm-9">
            @Model.DepartmentName
        </dd>

        <dt class="col-sm-3">
            Branch Id
        </dt>

        <dd class="col-sm-9">
            @Model.BranchId
        </dd>

    </dl>

    <form asp-action="DeleteDepartment"
          method="post">

        <input type="hidden"
               asp-for="DepartmentId" />

        <button type="submit"
                class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Departments"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
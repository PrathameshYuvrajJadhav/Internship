<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assignment_3__ASP.NET_Core_MVC_Task_1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assignment_3__ASP.NET_Core_MVC_Task_1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="About"
                   asp-action="Index">
                    MVC Training
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="History">History</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="Service">Service</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="About"
                               asp-action="Contact">Contact</a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6 text-center text-md-start">

                    <h5 class="mb-1">MVC Training</h5>

                    <p class="mb-0">
                        ASP.NET Core MVC Assignment
                    </p>

                </div>

                <div class="col-md-6 text-center text-md-end">

                    <p class="mb-0">
                        © 2026 All Rights Reserved
                    </p>

                </div>

            </div>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

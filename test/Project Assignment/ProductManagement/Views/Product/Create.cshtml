@model ProductManagement.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4">

    <h2>Add Product</h2>

    <form asp-action="Create">

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">
                Product Name
            </label>

            <input asp-for="ProductName"
                   class="form-control" />

            <span asp-validation-for="ProductName"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">
                Category
            </label>

            <input asp-for="Category"
                   class="form-control" />

            <span asp-validation-for="Category"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   class="form-control" />

            <span asp-validation-for="Price"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label">
                Stock Quantity
            </label>

            <input asp-for="StockQuantity"
                   class="form-control" />

            <span asp-validation-for="StockQuantity"
                  class="text-danger">
            </span>
        </div>

        <button type="submit" class="btn btn-success">
            Save Product
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>
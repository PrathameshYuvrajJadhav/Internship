@model ProductManagement.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">

    <h2>Edit Product</h2>

    <form asp-action="Edit">

        <input type="hidden" asp-for="ProductId" />

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">
                Product Name
            </label>

            <input asp-for="ProductName"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">
                Category
            </label>

            <input asp-for="Category"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label">
                Stock Quantity
            </label>

            <input asp-for="StockQuantity"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Update Product
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>